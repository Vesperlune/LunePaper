# ══════════════════════════════════════════
#  Paper Translator (LunePaper) — .gitignore
# ══════════════════════════════════════════

# ── 大模型文件（体积巨大，单独下载放置于根目录） ──
*.gguf
*.bin
*.pt
*.safetensors
test_model/
test_models/
models/

# ── C/C++ 动态链接库与编译产物 ──
*.dll
*.so
*.dylib
*.pdb
*.exp
*.lib
*.obj
*.o
*.a

# ── 外部依赖与编译目录 ──
llama.cpp/
build/
build_min/
dist/

# ── Python 运行时与虚拟环境 ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
.venv/
venv/
env/
.env
.env.*
!.env.example

# ── 前端依赖与产物 ──
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
.eslintcache

# ── 运行日志与调试文件 ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 用户任务数据、历史缓存与临时文件 ──
uploads/
history/
temp/
tmp/
*.tmp
*.bak

# ── 开发辅助、基准测试与临时分析脚本 ──
scratch/
.agents/
.system_generated/

# ── 背景图 & 公开资源（按需保留） ──
background/
frontend/public/bg.png
frontend/public/maid.png
frontend/public/maid_small.png
frontend/public/logo.jpg

# ── IDE 与系统文件 ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 测试与覆盖率 ──
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
